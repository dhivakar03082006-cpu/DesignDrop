# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase configuration (if omitted, DesignDrop uses its built-in Express API store)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Razorpay Test Mode key (falls back to interactive test checkout if blank)
VITE_RAZORPAY_TEST_KEY=""
